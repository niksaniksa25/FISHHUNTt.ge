:root{--bg:#07100c;--surface:#0d1b14;--surface2:#14291d;--text:#eff7f1;--muted:#95a79b;--line:rgba(255,255,255,.09);--accent:#b4ee72;--red:#ff6868;--gold:#e6bf58;--radius:18px}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,"Noto Sans Georgian",sans-serif;line-height:1.55}a{text-decoration:none;color:inherit}button,input,select,textarea{font:inherit}.container{width:min(1200px,94%);margin:0 auto}.header{position:sticky;top:0;z-index:100;background:rgba(7,16,12,.96);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.header-inner{height:76px;display:flex;align-items:center;justify-content:space-between}.logo{display:flex;align-items:center;gap:10px}.logo-mark{width:40px;height:40px;background:var(--accent);color:#0a190f;border-radius:10px;display:grid;place-items:center;font-weight:900;font-size:20px}.logo b{display:block;font-size:13px;letter-spacing:.16em}.logo small{display:block;font-size:8px;color:var(--muted);letter-spacing:.18em}.nav{display:flex;gap:4px;flex-wrap:wrap}.nav a{padding:9px 11px;border-radius:9px;color:#b9c8bf;font-size:12px}.nav a.active,.nav a:hover{background:var(--surface2);color:#fff}.menu{display:none;background:none;border:0;color:#fff;font-size:26px}.hero{padding:86px 0 72px;border-bottom:1px solid var(--line);background:radial-gradient(circle at 75% 10%,rgba(180,238,114,.1),transparent 28%),radial-gradient(circle at 15% 50%,rgba(114,180,150,.08),transparent 34%)}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:50px;align-items:center}.eyebrow{color:var(--accent);font-size:10px;font-weight:900;letter-spacing:.18em}.hero h1,.page-head h1{font-size:clamp(42px,6vw,76px);line-height:1;margin:15px 0 20px;letter-spacing:-.04em}.hero h1 span{color:#aebbb2}.hero p,.page-head p{color:#bdc9c2;max-width:760px}.actions{display:flex;gap:10px;margin-top:27px}.btn{min-height:45px;padding:0 16px;border-radius:10px;border:1px solid var(--line);display:inline-flex;align-items:center;justify-content:center;font-weight:900;cursor:pointer}.btn.primary{background:var(--accent);border-color:var(--accent);color:#0b160e}.btn.ghost{background:#0e1a13;color:#fff}.btn.danger{background:#2a1113;color:#ff9b9b;border-color:#6a2227}.full{width:100%}.panel{background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02));border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 18px 45px rgba(0,0,0,.22)}.hero-card{padding:24px}.row-between{display:flex;justify-content:space-between}.row-between>span{font-size:10px;color:var(--muted);font-weight:900}.hero-weather{display:flex;justify-content:space-between;align-items:center;margin:25px 0}.weather-icon{font-size:42px;display:block}.hero-weather strong{display:block;font-size:64px;line-height:.95}.hero-weather small{color:var(--muted)}.hero-score{text-align:right}.hero-score small{display:block;color:var(--muted)}.hero-score b{display:block;color:var(--accent);font-size:55px;line-height:1}.hero-score span{font-size:10px;color:var(--muted)}.mini-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);overflow:hidden;border-radius:12px}.mini-grid div{padding:12px;background:#0a170f}.mini-grid small{display:block;color:var(--muted);font-size:9px}.mini-grid b{font-size:14px}.section{padding:65px 0}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:19px}.section-head h2{margin:6px 0 0;font-size:28px}.link{color:var(--accent);font-weight:900;font-size:12px}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}.feature-card{padding:22px;border:1px solid var(--line);border-radius:16px;background:#0c1a12}.feature-card .icon{font-size:25px}.feature-card h3{margin:12px 0 7px}.feature-card p{margin:0;color:var(--muted);font-size:12px}.notice{padding:24px;display:flex;justify-content:space-between;gap:25px;align-items:center}.page-head{padding:68px 0 20px}.search-row{display:flex;gap:9px;margin-top:17px;max-width:850px}.search-row input,.search-row select,.fish-search-wrap input,.fish-search-wrap select,.place-tools input,.place-tools select,.form-card input,.form-card textarea,.map-side input{flex:1;min-height:45px;background:#0d1b13;color:#fff;border:1px solid var(--line);border-radius:10px;padding:0 12px;outline:none}.suggestions{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px}.suggestions button{border:1px solid var(--line);background:#12261a;color:#fff;border-radius:9px;padding:7px 9px;cursor:pointer;font-size:11px}.footer{border-top:1px solid var(--line);margin-top:30px;padding:35px 0;color:var(--muted)}.footer-grid{display:grid;grid-template-columns:1.2fr .7fr .6fr;gap:25px}.footer a{display:block;margin:4px 0}.footer-bottom{border-top:1px solid var(--line);margin-top:25px;padding-top:15px;text-align:center;font-size:10px}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px}.form-card,.account-panel{padding:24px}.form-card label{display:block;font-size:12px;font-weight:900;margin-top:12px}.form-card input,.form-card textarea{display:block;width:100%;margin-top:6px}.form-card textarea{padding:10px;min-height:120px}.form-actions{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}.trip-feed{display:grid;gap:12px}.trip-card{padding:18px;border:1px solid var(--line);border-radius:16px;background:#0d1b13}.trip-card small{color:var(--muted)}.map-shell{height:calc(100vh - 76px);display:grid;grid-template-columns:1fr 330px}.map-shell #map{height:100%}.map-side{border-radius:0;padding:16px;overflow:auto}.map-side input{width:100%;margin-bottom:8px}.map-info{margin-top:12px;padding:13px;border:1px solid var(--line);border-radius:11px;background:#0e1c13;color:var(--muted);font-size:12px}.metrics{display:grid;gap:12px}.metrics-6{grid-template-columns:repeat(6,1fr);margin-top:15px}.metrics>div{padding:15px;border:1px solid var(--line);background:#0d1b13;border-radius:14px;color:var(--muted);font-size:10px}.metrics b{display:block;color:#fff;font-size:17px;margin-top:6px}.weather-dashboard{padding:25px;display:flex;justify-content:space-between}.temp-big{display:flex;align-items:flex-start;margin-top:17px}.temp-big span{font-size:34px}.temp-big b{font-size:92px;line-height:.92}.weather-score{text-align:right}.weather-score b{display:block;font-size:70px;color:var(--accent);line-height:1}.small-head{margin-top:45px}.daily-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:10px}.daily-card{padding:16px;text-align:center;border:1px solid var(--line);border-radius:15px;background:#0d1b13}.daily-card.best{border-color:var(--accent);box-shadow:0 0 0 1px rgba(180,238,114,.2)}.daily-card .dicon{font-size:28px;margin:9px}.daily-card small{display:block;color:var(--muted);font-size:9px;margin-top:3px}.ai-layout{display:grid;grid-template-columns:280px 1fr;gap:16px}.ai-questions{padding:18px}.ai-questions button{width:100%;margin-bottom:7px;text-align:left;border:1px solid var(--line);background:#0e1b13;color:#fff;border-radius:9px;padding:9px;font-size:11px;cursor:pointer}.chat{min-height:600px;display:flex;flex-direction:column}.chat-messages{flex:1;padding:18px;overflow:auto}.user,.assistant{max-width:86%;padding:10px 12px;border-radius:12px;margin-bottom:9px;font-size:12px}.assistant{background:#12261a}.user{background:#1a3322;margin-left:auto}.chat-input{display:flex;gap:8px;padding:13px;border-top:1px solid var(--line)}.chat-input input{flex:1;min-height:44px;background:#0d1b13;color:#fff;border:1px solid var(--line);border-radius:10px;padding:0 12px}.empty{padding:40px;text-align:center;color:var(--muted)}.empty span{font-size:48px;display:block}.count-pill{padding:7px 9px;background:#12261a;border-radius:999px;color:var(--accent);font-size:10px}.fish-search-top{display:flex;justify-content:space-between;align-items:end;margin-bottom:17px}.fish-search-wrap{padding:10px;display:flex;gap:8px}.fish-results{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:12px}.fish-card{background:#0d1b13;border:1px solid var(--line);border-radius:15px;overflow:hidden;cursor:pointer}.fish-card:hover{border-color:rgba(180,238,114,.5);transform:translateY(-2px)}.fish-img{width:100%;height:145px;object-fit:cover;background:#12261a;display:block}.fish-card-body{padding:13px}.fish-card-body h3{font-size:14px;margin:0 0 4px}.fish-card-body p{font-size:10px;color:var(--muted);margin:0}.fish-profile{padding:22px}.fish-profile-grid{display:grid;grid-template-columns:300px 1fr;gap:18px}.fish-profile-img{width:100%;height:280px;object-fit:cover;border-radius:14px;background:#14291d}.fish-stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px}.fish-stat{padding:10px;border:1px solid var(--line);background:#0d1b13;border-radius:10px}.fish-stat small{display:block;color:var(--muted);font-size:9px}.fish-stat b{display:block;font-size:13px;margin-top:3px}.planner-grid{display:grid;grid-template-columns:290px 1fr;gap:16px}.planner-controls{padding:18px}.planner-controls label{display:block;font-size:11px;font-weight:900;margin-top:12px}.planner-controls input,.planner-controls select{width:100%;min-height:43px;background:#0d1b13;color:#fff;border:1px solid var(--line);border-radius:9px;padding:0 9px;margin-top:6px}.select-display{margin-top:6px;padding:10px;border:1px solid var(--line);border-radius:9px;background:#0d1b13;color:var(--accent);font-size:12px}.water-meta{font-size:10px;color:var(--muted);margin-top:5px}.day-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.day-card{padding:14px;border:1px solid var(--line);border-radius:14px;background:#0d1b13}.day-card.best{border-color:var(--accent)}.day-card h4{margin:0 0 8px}.day-card .score{font-size:28px;color:var(--accent);font-weight:900}.day-card small{display:block;color:var(--muted);font-size:9px;margin-top:3px}.best-callout{padding:16px;margin-top:12px}.best-callout strong{color:var(--accent)}.baro{padding:24px;display:grid;grid-template-columns:330px 1fr;gap:30px;align-items:center}.gauge{position:relative;width:280px;height:160px;margin:auto;border-radius:280px 280px 0 0;background:conic-gradient(from 270deg,#2b9e5b 0 33%,#d4b64a 33% 66%,#bd4d4d 66% 100%);overflow:hidden}.gauge:after{content:"";position:absolute;left:25px;right:25px;bottom:0;height:130px;border-radius:260px 260px 0 0;background:#0b170f}.gauge-needle{position:absolute;width:3px;height:105px;background:#fff;left:50%;bottom:4px;transform-origin:bottom center;transform:translateX(-50%) rotate(-30deg);z-index:2}.gauge-center{position:absolute;z-index:3;left:50%;bottom:18px;transform:translateX(-50%);text-align:center}.gauge-center b{font-size:26px}.gauge-center small{display:block;color:var(--muted);font-size:9px}.gauge-scale{position:absolute;inset:0;z-index:3;display:flex;justify-content:space-between;align-items:end;padding:0 18px 6px;font-size:9px;color:#cdd6d0}.location-layout{display:grid;grid-template-columns:1fr 330px;gap:14px;margin-top:14px}.place-tools{padding:10px;display:grid;grid-template-columns:1.5fr .7fr .9fr auto;gap:8px}.location-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.location-card{overflow:hidden;border:1px solid var(--line);border-radius:16px;background:#0d1b13;cursor:pointer}.location-card img{width:100%;height:155px;object-fit:cover;background:#12261a}.location-card-body{padding:13px}.location-card-body h3{font-size:14px;margin:0 0 4px}.location-card-body small{display:block;color:var(--muted);font-size:9px}.location-card-body p{color:var(--muted);font-size:10px}.location-profile{padding:18px;height:max-content;position:sticky;top:92px}.profile-image{width:100%;height:180px;object-fit:cover;border-radius:12px;background:#12261a}.tag{display:inline-block;padding:4px 7px;border-radius:999px;background:#173021;color:var(--accent);font-size:9px;margin:8px 4px 0 0}.danger{color:#ff9a9a}.muted{color:var(--muted)}@media(max-width:1000px){.nav{display:none;position:absolute;top:72px;left:3%;right:3%;background:#09170e;border:1px solid var(--line);border-radius:12px;padding:8px;flex-direction:column}.nav.open{display:flex}.menu{display:block}.hero-grid,.two-col,.planner-grid,.location-layout,.fish-profile-grid,.baro{grid-template-columns:1fr}.feature-grid{grid-template-columns:1fr 1fr}.fish-results,.location-grid{grid-template-columns:repeat(2,1fr)}.daily-grid{display:flex;overflow:auto}.daily-card{min-width:140px}.day-cards{grid-template-columns:repeat(2,1fr)}.metrics-6{grid-template-columns:repeat(3,1fr)}.map-shell{grid-template-columns:1fr;height:auto}.map-shell #map{height:520px}.map-side{border-radius:0}.location-profile{position:static}}@media(max-width:620px){.hero h1,.page-head h1{font-size:40px}.feature-grid,.fish-results,.location-grid,.fish-stat-grid{grid-template-columns:1fr}.mini-grid{grid-template-columns:1fr 1fr}.search-row,.fish-search-wrap{flex-wrap:wrap}.search-row input,.fish-search-wrap input{flex-basis:100%}.metrics-6{grid-template-columns:1fr 1fr}.weather-dashboard{display:block}.weather-score{text-align:left;margin-top:20px}.temp-big b{font-size:73px}.place-tools{grid-template-columns:1fr}.day-cards{grid-template-columns:1fr}.fish-profile-img{height:220px}.footer-grid{grid-template-columns:1fr}}
.baro{padding:24px;display:grid;grid-template-columns:330px 1fr;gap:30px;align-items:center}.gauge{position:relative;width:280px;height:160px;margin:auto;border-radius:280px 280px 0 0;background:conic-gradient(from 270deg,#2b9e5b 0 33%,#d4b64a 33% 66%,#bd4d4d 66% 100%);overflow:hidden}.gauge:after{content:"";position:absolute;left:25px;right:25px;bottom:0;height:130px;border-radius:260px 260px 0 0;background:#0b170f}.gauge-needle{position:absolute;width:3px;height:105px;background:#fff;left:50%;bottom:4px;transform-origin:bottom center;transform:translateX(-50%) rotate(-30deg);z-index:2;box-shadow:0 0 8px rgba(255,255,255,.4)}.gauge-center{position:absolute;z-index:3;left:50%;bottom:18px;transform:translateX(-50%);text-align:center}.gauge-center b{font-size:26px}.gauge-center small{display:block;color:var(--muted);font-size:9px}.gauge-scale{position:absolute;inset:0;z-index:3;display:flex;justify-content:space-between;align-items:end;padding:0 18px 6px;font-size:9px;color:#cdd6d0}@media(max-width:1000px){.baro{grid-template-columns:1fr}}
hr{border:0;border-top:1px solid var(--line);margin:14px 0}.route-active{border-color:var(--accent)!important}.catalog-profile{background:#0d1b13}.feature-card{transition:.2s ease}.feature-card:hover{transform:translateY(-2px);border-color:rgba(180,238,114,.35)}
